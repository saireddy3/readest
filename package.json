{
  "name": "@skillsoft/book-reader",
  "version": "0.0.2",
  "description": "A framework-agnostic e-book reader component library for React applications",
  "publishConfig": {
    "registry": "https://nexus.tools.squads-dev.com/repository/npm-skillsoft/"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./dist/index.css": "./dist/index.css"
  },
  "scripts": {
    "dev": "dotenv -e .env.web -- next dev -p 4000",
    "build": "dotenv -e .env.web -- next build",
    "build:static": "dotenv -e .env.static -- next build",
    "start": "dotenv -e .env.web -- next start",
    "i18n:extract": "i18next-scanner",
    "lint": "next lint",
    "build:package": "tsup --config tsup.config.js",
    "build:lib": "tsup --config tsup.config.js",
    "prepublishOnly": "npm run build:lib"
  },
  "dependencies": {
    "@skillsoft/foliate-js": "^0.0.1",
    "@zip.js/zip.js": "^2.7.53",
    "clsx": "^2.1.1",
    "cssbeautify": "^0.3.1",
    "react-color": "^2.19.3",
    "react-responsive": "^10.0.0",
    "tinycolor2": "^1.6.0"
  },
  "peerDependencies": {
    "i18next": "^24.0.0",
    "i18next-browser-languagedetector": "^8.0.0",
    "i18next-http-backend": "^3.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "react-i18next": "^15.0.0",
    "react-icons": "^5.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.24.0",
    "autoprefixer": "^10.4.20",
    "cpx2": "^8.0.0",
    "daisyui": "^4.12.24",
    "dotenv-cli": "^7.4.4",
    "eslint": "^9.16.0",
    "eslint-config-next": "15.0.3",
    "i18next": "^24.2.0",
    "i18next-browser-languagedetector": "^8.0.2",
    "i18next-http-backend": "^3.0.1",
    "i18next-scanner": "^4.6.0",
    "mkdirp": "^3.0.1",
    "next": "15.2.4",
    "node-env-run": "^4.0.2",
    "postcss": "^8.4.49",
    "postcss-cli": "^11.0.0",
    "postcss-nested": "^7.0.2",
    "raw-loader": "^4.0.2",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-i18next": "^15.4.1",
    "react-icons": "^5.4.0",
    "tailwindcss": "^3.4.17",
    "tsup": "^8.0.1",
    "typescript": "^5.0.0",
    "zustand": "5.0.1"
  },
  "keywords": [
    "ebook",
    "reader",
    "epub",
    "react",
    "framework-agnostic",
    "component-library",
    "vite",
    "nextjs"
  ]
}
